PORT=5000
GITHUB_API_TOKEN=your_github_personal_access_token_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/github_insight?retryWrites=true&w=majority
NODE_ENV=development
# For multiple origins, comma-separate them:
# CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- RAG (Optional) ---
# MODE 1: CLOUD (default) - Google Gemini API (free tier, no downloads)
# Get a free API key at: https://aistudio.google.com/apikey
RAG_MODE=cloud
GEMINI_API_KEY=your_free_gemini_api_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-flash-latest

# MODE 2: LOCAL (fully offline) - Ollama + ChromaDB
# Uncomment to use local mode instead:
# RAG_MODE=local
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_LLM_MODEL=llama3.2
# CHROMA_URL=http://localhost:8000
